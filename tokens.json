{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Design tokens for bryan_kulba_blog. Portable to other projects.",

  "color": {
    "$description": "All color decisions for the site.",
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#4D9DA8",
        "$description": "Teal blue — primary brand color, used for headings, links, category badges, and header accent border."
      },
      "accent": {
        "$type": "color",
        "$value": "#E43131",
        "$description": "Bright red — used for hover states, blockquote border, footer border, and interactive highlights."
      },
      "background": {
        "$type": "color",
        "$value": "#fbf6eb",
        "$description": "Pale beige — main page background, also used for header background."
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "#1A3A41",
        "$description": "Dark teal — primary body text. High contrast on the pale beige background."
      },
      "secondary": {
        "$type": "color",
        "$value": "#4A4A4A",
        "$description": "Dark gray — secondary/meta text (dates, descriptions, nav links)."
      }
    },
    "ui": {
      "link": {
        "$type": "color",
        "$value": "{color.brand.primary}",
        "$description": "Default link color — aliases brand primary."
      },
      "link-hover": {
        "$type": "color",
        "$value": "{color.brand.accent}",
        "$description": "Link hover color — aliases brand accent."
      },
      "border": {
        "$type": "color",
        "$value": "{color.brand.accent}",
        "$description": "Default border color — aliases brand accent."
      },
      "heading": {
        "$type": "color",
        "$value": "{color.brand.primary}",
        "$description": "Heading color — aliases brand primary."
      },
      "link-heading": {
        "$type": "color",
        "$value": "{color.brand.primary}",
        "$description": "Link color specifically inside headings (e.g. h2 post-title links in the posts grid). Currently the same as link, but is a separate design decision — heading links can diverge from body text links independently."
      },
      "code-background": {
        "$type": "color",
        "$value": "#f6f6f6",
        "$description": "Background for inline code and pre blocks."
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.9)",
        "$description": "Lightbox/modal overlay background."
      },
      "category-badge-text": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Text color for category badge chips."
      }
    }
  },

  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["DM Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"],
        "$description": "Primary sans-serif stack — body text, nav, UI elements."
      },
      "serif": {
        "$type": "fontFamily",
        "$value": ["DM Serif Display", "serif"],
        "$description": "Display serif — used for headings h1–h3 and the site logo."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
        "$description": "Monospace stack — code blocks."
      }
    },
    "size": {
      "base": {
        "$type": "dimension",
        "$value": "18px",
        "$description": "Root font size, set on <html>."
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$description": "Small text — 14px at base size. Used for meta, descriptions, nav links."
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Large text — ~20px at base size. Used for logo."
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.75rem",
        "$description": "Extra large — ~31px. Used for post preview headings, post content h2."
      },
      "2xl": {
        "$type": "dimension",
        "$value": "2.25rem",
        "$description": "2x large — ~40px. Used for lightbox close button."
      },
      "3xl": {
        "$type": "dimension",
        "$value": "3rem",
        "$description": "3x large — 54px. Used for h1."
      }
    },
    "weight": {
      "normal": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Used for post navigation links."
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Used for h4 labels."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.2,
        "$description": "Headings."
      },
      "snug": {
        "$type": "number",
        "$value": 1.3,
        "$description": "H3 headings."
      },
      "normal": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Secondary body text, descriptions."
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.6,
        "$description": "Primary body text."
      }
    },
    "letterSpacing": {
      "wide": {
        "$type": "dimension",
        "$value": "0.08em",
        "$description": "Used for h4 uppercase labels."
      },
      "wider": {
        "$type": "dimension",
        "$value": "0.1em",
        "$description": "Used for h4 in post content."
      }
    }
  },

  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "Base spacing unit. Multiples of this drive all layout spacing."
    },
    "xs": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "0.25× unit — tight padding, e.g. category badge vertical padding."
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$description": "0.5× unit — list item gap, tag margin."
    },
    "md": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "1× unit — standard padding, paragraph margin."
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.5rem",
      "$description": "1.5× unit — nav gap, header padding."
    },
    "xl": {
      "$type": "dimension",
      "$value": "2rem",
      "$description": "2× unit — section padding, grid gap."
    },
    "2xl": {
      "$type": "dimension",
      "$value": "3rem",
      "$description": "3× unit — post header margin, post footer margin."
    }
  },

  "layout": {
    "contentMaxWidth": {
      "$type": "dimension",
      "$value": "684px",
      "$description": "Maximum width for readable prose content (single post)."
    },
    "containerMaxWidth": {
      "$type": "dimension",
      "$value": "1200px",
      "$description": "Maximum width for the outer container. Currently unused in favor of WP content size var."
    },
    "containerPadding": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "Horizontal padding on the .container element."
    },
    "gridMinItemWidth": {
      "$type": "dimension",
      "$value": "300px",
      "$description": "Minimum column width in the posts grid (auto-fill)."
    }
  },

  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px",
      "$description": "Mobile nav collapses below this width."
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    }
  },

  "border": {
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$description": "Used for category badge chips."
      },
      "md": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "Used for post preview cards, code blocks."
      },
      "lg": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "image": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Used directly on images in post content and feature images."
      }
    },
    "width": {
      "accent": {
        "$type": "dimension",
        "$value": "5px",
        "$description": "Top border on site header."
      },
      "blockquote": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Left border on blockquotes."
      }
    }
  },

  "transition": {
    "base": {
      "$type": "transition",
      "$value": { "duration": "300ms", "timingFunction": "ease", "delay": "0ms" },
      "$description": "Standard transition — links, cards, nav items."
    },
    "fast": {
      "$type": "transition",
      "$value": { "duration": "150ms", "timingFunction": "ease", "delay": "0ms" },
      "$description": "Fast transition — hamburger menu icon lines."
    }
  }
}
